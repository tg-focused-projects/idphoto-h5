# 复制成 .env 再填（.env 已 gitignore）
# frp 隧道 token（frps 端 frps.toml 里 auth.token 的值）
FRP_AUTH_TOKEN=
# ── c2a 公网网关（/c2a/*）────────────────────────────────────────
# 暴露 key（逗号分隔，多把可轮换）。不设则从 api-keys.json 的 c2aKeys 读。
# 注意：这不是 chatgpt2api 的 admin key，admin key 只在服务端注入。
C2A_EXPOSE_KEYS=
# 每个 IP 每分钟允许的 c2a 调用次数（生图很贵，默认 12）
C2A_RATE_PER_MINUTE=12